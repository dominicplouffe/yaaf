    "registrar-ink": {
      "$type": "color",
      "$value": "#161A2E",
      "$description": "Primary ink. Text, marks, the maker. Navy only ever appears as ink on paper."
    },
    "registry": {
      "$type": "color",
      "$value": "#F4F4F1",
      "$description": "Primary paper. Default light background. Near-neutral on purpose (not ivory)."
    },
    "seal": {
      "$type": "color",
      "$value": "#B8203A",
      "$description": "The countersign: the checker's signature. The italic a, and the name of whoever checked. Never a status, never an error."
