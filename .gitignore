__pycache__/
*.pyc
.venv/
# Written by `uv run`, which is one convenient way to get the dev extras on
# this box. This project pins through pyproject.toml and has never carried a
# lockfile; one appeared here as a side effect of a tool, not a decision, and
# committing it would pin the whole dependency graph for everybody. If the
# project ever wants that, it should be a deliberate commit rather than an
# artifact somebody's shell left behind.
uv.lock
*.egg-info/
# setuptools / `python -m build` output. Sixty-seven files of it were committed
# once — a stale duplicate of the whole package, still carrying code that had
# been deleted from the real one, and failing `ruff check .` in CI.
build/
dist/
.env
.pytest_cache/
.ruff_cache/
data/
*.db
deploy/.env
# Per-machine compose tweaks (loopback port binding on remote boxes, etc.)
deploy/docker-compose.override.yml
notes.txt
web/node_modules/
web/dist/

# Per-role egress config, regenerated from the live role library every 15s by
# the runner. All of it is machine state — the allowlists carry site domains,
# and roles.conf carries one port block per role in THAT box's database. It
# used to be tracked, on the theory that it was "ports only"; what that bought
# was a file permanently showing as modified and an update script that refused
# to run because of it. It now lives in /var/lib/yaaf/proxy-generated.
deploy/proxy/generated/

# Session handoff notes for Claude — local only
HANDOFF.md

# Database dumps taken by update_single_server.sh
backups/
.venv/

# Project goals and setup files for private work — customer names, MCP hosts.
# Kept out of docs/ while squash-to-public is undecided.
local/

# pytest-testmon's coverage map for change-scoped local runs
.testmondata
.testmondata-*

# Stray output from running the website toolchain in this checkout by mistake.
.astro/
dist/
